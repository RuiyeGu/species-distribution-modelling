{
  "splits": {
    "spatial": {
      "train": "spatial_train.csv",
      "test": "spatial_test.csv"
    },
    "random": {
      "train": "random_train.csv",
      "test": "random_test.csv"
    }
  },
  "predictors": [
    "easting",
    "northing",
    "disturb",
    "rainann",
    "soildepth",
    "soilfert",
    "tempann",
    "topo"
  ],
  "coordinate_predictors": [
    "easting",
    "northing"
  ],
  "environmental_predictors": [
    "disturb",
    "rainann",
    "soildepth",
    "soilfert",
    "tempann",
    "topo"
  ],
  "target": "pres.abs",
  "species": "Species",
  "group": "plot",
  "id": "id",
  "preprocessing": {
    "missing_values": "median",
    "scaling": "standard"
  },
  "metrics": [
    "log_loss",
    "auc",
    "average_precision",
    "brier",
    "f1",
    "sensitivity",
    "specificity"
  ],
  "tuning": {
    "scope": "training_only",
    "cv_method": "stratified_group_k_fold",
    "n_splits": 5,
    "group_column": "plot",
    "selection_metric": "log_loss",
    "selection_direction": "minimize",
    "refit_on_full_training_set": true,
    "evaluate_test_once": true
  },
  "threshold": 0.5,
  "random_seed": 42
}
